# 后端 · 本机直跑（不走 Docker）时才需要补这些
# 完整清单见仓库根 .env.example —— 那份是权威来源，compose 自动注入给容器。
# 这里只列"容器里由 compose 网络提供的值，本机直跑要改成 localhost"的部分。

# 把容器名换成 localhost
POSTGRES_HOST=localhost
MILVUS_HOST=localhost
DATABASE_URL=postgresql+psycopg://copilot:copilot_pass@localhost:5432/research_copilot

# MinerU 独立 venv 的写法（Windows 示例）；装了才需要写，不装就 MINERU_ENABLED=false
# MINERU_CMD=C:/Users/you/venvs/mineru/Scripts/mineru.exe
# MINERU_ENABLED=false

# 本机直跑时模型缓存用本地目录（容器里是 /models 卷）
MODELSCOPE_CACHE=./.models

# 仍必填的两项
LLM_API_KEY=sk-REPLACE_ME
SECRET_KEY=change-me-to-a-random-32-byte-hex
