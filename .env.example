# ============================================================================
# Research Copilot · 环境变量模板
# 用法：cp .env.example .env  然后按注释填写。
#      .env 会被 docker compose 自动读取；backend 通过 compose 注入。
#       没有 worker —— 长任务在 backend 进程内跑（Redis 只做缓存，不是任务队列）。
#      不要在 .env 里写引号，compose 会把它当成值的一部分。
# ============================================================================

# ---------------------------------------------------------------- 通用
ENV=development                      # development | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
COMPOSE_PROJECT_NAME=research-copilot

# ---------------------------------------------------------------- PostgreSQL 16
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_pass       # ★生产务必改
POSTGRES_DB=research_copilot
POSTGRES_PORT_HOST=5432              # 宿主机映射端口（容器内固定 5432）
DB_CONNECT_TIMEOUT=3                 # 连不上时的超时（秒）；不设会让 /health 永久挂住

# ---------------------------------------------------------------- 文档解析：MinerU
# MinerU 是首选解析器（版面还原 / OCR / 公式 / 表格），以 CLI 形式调用。
# 它依赖 torch + 数 GB 模型权重，所以**不在后端镜像里**，推荐单独 venv / 单独容器：
#     python -m venv /opt/mineru && /opt/mineru/bin/pip install "mineru[core]"
#     然后把 MINERU_CMD 指到 /opt/mineru/bin/mineru
# 本机（Windows 独立 venv 的写法）：
#     MINERU_CMD=C:/Users/you/venvs/mineru/Scripts/mineru.exe
# 不想装就设 MINERU_ENABLED=false，解析自动降级到 PyMuPDF（页码仍在，版式变粗）。
MINERU_ENABLED=true                 # false = 完全不调 MinerU，直接用降级链
MINERU_CMD=mineru                   # 裸命令走 PATH，也可写绝对路径
MINERU_METHOD=auto                  # auto | txt | ocr（对应 CLI 的 -m）
MINERU_DEVICE=cpu                   # cpu | cuda（对应 -d）
MINERU_TIMEOUT=600                  # 整篇解析上限（秒）；CPU 上每页数秒起
MINERU_EXTRA_ARGS=                  # 追加 CLI 参数（-f / -t / -l 等版本差异项从这里补）
INSTALL_MINERU=false                # 仅 compose 构建用：true 则把 MinerU 装进后端镜像

# ---------------------------------------------------------------- Milvus 2.4 standalone
# 两个集合：chunk 级双向量（dense+sparse）、论文级摘要向量（语义去重）
MILVUS_CHUNKS_COLLECTION=paper_chunks     # chunk 集合：dense_embedding + sparse_embedding
MILVUS_SUMMARIES_COLLECTION=paper_summaries  # 论文级摘要向量，用于语义去重
MILVUS_DENSE_DIM=1024                # bge-m3 dense 维度，勿改
MILVUS_PORT_HOST=19530
MILVUS_METRICS_PORT_HOST=9091
# 本地开发可填文件路径走 milvus-lite（无需 Docker），留空则连上面的 host:port。
# 注意：**不要**把这个变量命名成 MILVUS_URI —— 那是 pymilvus 自己读的变量，
# 它要求 http(s):// 形式且在 import 期校验，填路径会让 `import pymilvus` 直接崩。
MILVUS_LITE_PATH=
# --- Milvus 的后端存储（仅 compose 内部使用，通常不用动）---
MINIO_ACCESS_KEY=minioadmin          # ★生产务必改
MINIO_SECRET_KEY=minioadmin          # ★生产务必改
MINIO_BUCKET=milvus-bucket

# ---------------------------------------------------------------- Redis 7（三库之三）
# 不承载任务队列（没有 Celery），只做缓存 / 去重标记 / 限流；挂了不影响主链路。
REDIS_PORT_HOST=6379                 # 宿主机映射端口（容器内固定 6379）
REDIS_DB=0
REDIS_PASSWORD=                      # 生产建议设；设了会带进 REDIS_URL
# REDIS_URL=redis://localhost:6379/0  # 给了就以它为准，忽略上面的 HOST/PORT/DB

# ---------------------------------------------------------------- 检索 / 融合参数
RRF_K=60                             # RRF 融合常数（论文默认 60）
RETRIEVAL_TOP_K=20                   # 重排后进入上下文的 chunk 数
RETRIEVAL_RECALL_K=50                # 每路召回的候选数
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------- CRAG 三级降级
CRAG_ENABLED=true
CRAG_RELEVANCE_THRESHOLD=0.5         # ≥ 判 relevant
CRAG_AMBIGUOUS_LOW=0.3               # [0.3, 0.5) 判 ambiguous → Query Rewrite
CRAG_REWRITE_MAX_RETRY=3             # ambiguous 最多重写 3 次；再不行降级 Web Search
GROUNDING_MIN_RATIO=0.8              # 溯源闸门：低于此值拒答或标注低置信

# ---------------------------------------------------------------- LLM（OpenAI 兼容端点）
# 本项目统一走 openai SDK 的 base_url 切换。示例值：
#   DeepSeek  : https://api.deepseek.com/v1        model=deepseek-chat
#   Qwen      : https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
#   OpenAI    : https://api.openai.com/v1          model=gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-REPLACE_ME            # ★必填
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_PLANNER=deepseek-chat      # Planner 用高性能模型
LLM_MODEL_EXECUTOR=deepseek-chat     # Executor 可用性价比模型（成本优化）
LLM_MODEL_REVIEWER=deepseek-chat     # Reviewer / 意图识别
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
INTENT_CONFIDENCE_THRESHOLD=0.6      # 低于此值触发 Clarify 澄清追问
REFLECTION_MAX_REFINE=2              # Reviewer 不达标时最多 refine 2 次
REPLAN_MAX_ROUNDS=2                  # Replanner 最多 2 轮重规划

# ---------------------------------------------------------------- Embedding（bge-m3 双向量）
EMBEDDING_BACKEND=modelscope         # modelscope | local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu                 # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
# ModelScope 下载缓存（compose 内挂到 /models 卷，避免每次重建重新下载 ~2GB）
MODELSCOPE_CACHE=/models

# ---------------------------------------------------------------- MCP 工具
MCP_TIMEOUT=60                       # 单次 MCP 调用超时（秒）
MCP_ARXIV_ENABLED=true
MCP_PUBMED_ENABLED=true
MCP_SEMANTIC_SCHOLAR_ENABLED=true
MCP_PYTHON_EXEC_ENABLED=true
MCP_WEB_SEARCH_ENABLED=true
PYTHON_EXEC_TIMEOUT=10               # 沙箱单次执行上限（秒）
PYTHON_EXEC_MAX_MEM_MB=512
# 各数据源凭据（均为可选：不填则走匿名/低频通道）
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=                        # PubMed E-utilities，填了配额从 3/s 提到 10/s
TAVILY_API_KEY=                      # Web Search Fallback 用；不填则 CRAG 第三级降级不可用

# ---------------------------------------------------------------- 后端服务
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-to-a-random-32-byte-hex   # ★必改：openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=100                    # 单篇 PDF 上限

# ---------------------------------------------------------------- 前端
FRONTEND_PORT=3000
# 浏览器直接访问后端，因此填 localhost 而不是容器名
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_SSE_BASE=http://localhost:8000/api/v1
